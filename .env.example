# 启用 MySQL Compose profile；改用 SQLite 时设为空。
COMPOSE_PROFILES=mysql

# 数据库后端：sqlite 或 mysql。未配置时默认为 sqlite。
DATABASE_BACKEND=mysql

# 本地直接运行后端时使用；Docker Compose 内会自动改为 mysql:3306。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=ashare_ledger
MYSQL_USER=ashare
MYSQL_PASSWORD='change-me@2026'

# 可选：Compose 初始化 MySQL 时使用，不配置则采用开发默认值。
MYSQL_ROOT_PASSWORD='change-me-root@2026'

# 可选：显式连接串优先级最高。仅在需要覆盖上面的分项配置时启用。
# DATABASE_URL=mysql+pymysql://user:password@host:3306/database?charset=utf8mb4

# 可选运行参数。
# 后端 HTTP 服务监听端口（1-65535，默认 12011）。
SERVER_PORT=12011
ECHO_SQL=0
QUOTE_PROVIDER=eastmoney
QUOTE_TIMEOUT_SECONDS=5
# 后端日志等级：支持 DEBUG、INFO、WARNING、ERROR、CRITICAL，未配置时默认为 INFO。
LOG_LEVEL=INFO

# 用户体系与登录态配置。
# 默认管理员邮箱：存量数据会自动归属该管理员；EMAIL_PROVIDER=smtp 时必填，console 模式默认 admin@localhost。
DEFAULT_ADMIN_EMAIL=admin@example.com
# 验证码 HMAC 哈希密钥；生产环境请替换为随机长字符串。
AUTH_SECRET_KEY='change-me-auth-secret-2026'
# 登录态有效天数（默认 30 天）。
AUTH_SESSION_DAYS=30
# 会话 Cookie 名称与 HTTPS 安全标志（HTTPS 部署时设为 true）。
AUTH_COOKIE_NAME=wing_session
AUTH_COOKIE_SECURE=false

# 邮件发送配置：console（本地开发，验证码打印到后端日志）或 smtp（生产发信）。
EMAIL_PROVIDER=console
# 以下为 EMAIL_PROVIDER=smtp 时的必填/可选参数（SMTP_USE_TLS 与 SMTP_USE_SSL 互斥）。
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@example.com
# SMTP_PASSWORD='change-me-smtp-password'
# SMTP_FROM=noreply@example.com
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false
